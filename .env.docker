# ============================================================
# Portal PGE-MS — Variaveis de Ambiente para Docker
# ============================================================
# Este arquivo contem valores PADRAO para desenvolvimento local.
# Para personalizar, copie para .env.docker.local e edite:
#   cp .env.docker .env.docker.local
#
# NUNCA coloque secrets reais neste arquivo (ele e commitado no git).
# ============================================================

# Banco (gerenciado pelo docker-compose — NAO alterar host/porta)
DATABASE_URL=postgresql://postgres:postgres@db:5432/portal_pge

# Ambiente
ENV=development

# JWT
SECRET_KEY=dev-docker-secret-key-troque-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin inicial (criado automaticamente no primeiro start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# TJ-MS (opcional para dev — deixe vazio se nao precisar)
TJ_WS_USER=
TJ_WS_PASS=

# Gemini (opcional para dev — deixe vazio se nao precisar)
GEMINI_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
