# ==================================================
# .env.example — config de desenvolvimento local
# ==================================================
# Em PRODUCAO, todas as variaveis sao injetadas pelo ECS
# a partir do AWS Secrets Manager (portal-pge/app-config).
# Veja docs/operacoes/AWS_DEPLOY.md.
# ==================================================

# ==================================================
# BANCO DE DADOS (PostgreSQL obrigatorio)
# ==================================================
# Local (recomendado): instalar Postgres e criar DB portal_pge
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/portal_pge

# ==================================================
# AMBIENTE
# ==================================================
ENV=development

# ==================================================
# JWT
# ==================================================
# Gere uma chave segura com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_SEGURA_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Credenciais do admin inicial (obrigatorias)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DEFINA_SENHA_FORTE_AQUI

# Senha padrao para novos usuarios (devem trocar no primeiro login)
DEFAULT_USER_PASSWORD=mudar123

# ==================================================
# CORS — origens permitidas (separadas por virgula)
# ==================================================
# Em producao: https://pgems.app,https://www.pgems.app
# Em dev: deixe vazio (main.py adiciona automatic localhost:3000/5173/8000)
ALLOWED_ORIGINS=

# ==================================================
# TJ-MS (webservice MNI)
# ==================================================
TJ_WSDL_URL=https://esaj.tjms.jus.br/mniws/servico-intercomunicacao-2.2.2/intercomunicacao?wsdl
TJ_WS_USER=SEU_USUARIO_TJMS
TJ_WS_PASS=SUA_SENHA_TJMS

# ==================================================
# TJ-MS (Playwright/scraping — opcional)
# ==================================================
TJMS_USUARIO=
TJMS_SENHA=
TJMS_PROXY_URL=
TJMS_PROXY_LOCAL_URL=

# ==================================================
# Google Gemini (IA principal)
# ==================================================
GEMINI_KEY=SUA_API_KEY_GEMINI

# ==================================================
# OpenRouter (IA fallback)
# ==================================================
OPENROUTER_API_KEY=SUA_API_KEY_OPENROUTER
OPENROUTER_MODEL=google/gemini-3.7-flash
FULL_REPORT_MODEL=google/gemini-3.7-flash

# ==================================================
# SAJ Bridge (proxy de integracao)
# ==================================================
SAJ_BRIDGE_URL=
SAJ_BRIDGE_API_KEY=

# ==================================================
# Opcionais (Playwright)
# ==================================================
DELAY_MIN=2.0
DELAY_MAX=5.0
MAX_TENTATIVAS=3
HEADLESS=true
